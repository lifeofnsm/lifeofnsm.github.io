---
// Simple content page: dark title band + narrow column.
// Markdown pages use it via `layout: ../layouts/PageLayout.astro` in their front-matter.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  updated?: string;
  intro?: string;
  frontmatter?: { title: string; description?: string; updated?: string; intro?: string };
}
const fm = Astro.props.frontmatter ?? Astro.props;
const { title = '', description, updated, intro } = fm;
---
<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container-narrow">
      <a href="/" class="crumb">Home</a><span class="crumb-sep">/</span><span class="crumb-current">{title}</span>
      <h1 class="display">{title}</h1>
      {intro && <p class="page-hero__intro">{intro}</p>}
      {updated && <p class="page-hero__meta">Last updated: {updated}</p>}
    </div>
  </section>
  <div class="container-narrow page-body">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero { background: var(--ink); color: #fff; padding: 48px 0 44px; position: relative; overflow: hidden; }
  .page-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(520px 300px at 90% 0%, rgba(37,99,235,.38), transparent 70%); pointer-events: none; }
  .page-hero .container-narrow { position: relative; }
  .crumb { color: var(--ink-muted); text-decoration: none; font-size: 13px; }
  .crumb:hover { color: #fff; }
  .crumb-sep { color: #475569; margin: 0 8px; font-size: 13px; }
  .crumb-current { color: #fff; font-size: 13px; }
  .page-hero h1 { font-size: clamp(32px, 5vw, 46px); margin-top: 14px; }
  .page-hero__intro { color: var(--ink-muted); font-size: 16.5px; margin-top: 12px; max-width: 600px; }
  .page-hero__meta { color: #64748B; font-size: 13px; margin-top: 12px; }
  .page-body { padding-top: 44px; padding-bottom: 80px; }
</style>
