---
// Financial calculators. Markup is below; logic lives in /public/js/calculators.js
// and the calculator-specific styles in src/styles/calculators.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/calculators.css';
import { site } from '../data/site';

const schema = [{
  '@type': 'WebApplication',
  name: 'Financial Calculators by Nataraj Malavade',
  url: `${site.url}/tools.html`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: ['SIP calculator', 'Step-up SIP calculator', 'Lumpsum calculator', 'Goal planner', 'EMI calculator', 'Monte Carlo retirement (Financial Freedom Number) calculator'],
  creator: { '@id': `${site.url}/#person` },
}];
---
<BaseLayout
  title="SIP, EMI & Retirement Calculators"
  description="Free SIP, step-up SIP, lumpsum, goal and EMI calculators, plus a Monte Carlo test for your Financial Freedom Number. No sign-up, instant results."
  breadcrumb="Financial Calculators"
  schema={schema}
>
  <section class="page-hero">
    <div class="container-narrow">
      <a href="/" class="crumb">Home</a><span class="crumb-sep">/</span><span class="crumb-current">Calculators</span>
      <h1 class="display">Financial Calculators</h1>
      <p>Free tools to plan your SIP, lumpsum, goals, EMI and financial freedom. No sign-up, instant results.</p>
      <button class="btn btn-light btn-sm" type="button" onclick="showPanel('retire',null);setTimeout(()=>document.getElementById('panel-retire').scrollIntoView({behavior:'smooth',block:'start'}),50);">
        🎯 Know your Financial Freedom Number →
      </button>
    </div>
  </section>

  <div class="container-narrow calc-app">
    <div class="tab-section">
      <div class="tab-label">Calculators</div>
      <div class="tab-row">
        <button class="tab-btn active" onclick="showPanel('sip',this)"><span class="ti">📊</span>Returns</button>
        <button class="tab-btn" onclick="showPanel('goal',this)"><span class="ti">🎯</span>Goal</button>
        <button class="tab-btn" onclick="showPanel('emi',this)"><span class="ti">🏦</span>EMI</button>
        <button class="tab-btn" onclick="showPanel('retire',this)"><span class="ti">🔢</span>Freedom No.</button>
      </div>
    </div>
  
    <!-- SIP + LUMPSUM -->
    <div class="calc-panel active" id="panel-sip">
      <div class="inner-tabs">
        <button class="inner-tab active" onclick="switchReturnTab('sip',this)">Regular SIP</button>
        <button class="inner-tab" onclick="switchReturnTab('stepup',this)">Step Up SIP</button>
        <button class="inner-tab" onclick="switchReturnTab('lumpsum',this)">Lumpsum</button>
      </div>
      <div id="sip-inputs">
        <div class="form-card">
          <div class="calc-grid">
            <div class="input-group"><label>Monthly SIP Amount</label><div class="input-row"><span class="iul">₹</span><input type="number" id="s_amount" value="10000" oninput="ss('s_amount','s_amountR')"/></div><input type="range" id="s_amountR" min="500" max="200000" step="500" value="10000" oninput="si('s_amountR','s_amount')"/></div>
            <div class="input-group"><label>Expected Annual Return</label><div class="input-row"><input type="number" id="s_rate" value="12" step="0.5" oninput="ss('s_rate','s_rateR')"/><span class="iu">%</span></div><input type="range" id="s_rateR" min="1" max="30" step="0.5" value="12" oninput="si('s_rateR','s_rate')"/></div>
            <div class="input-group"><label>Investment Duration</label><div class="input-row"><input type="number" id="s_years" value="10" oninput="ss('s_years','s_yearsR')"/><span class="iu">Yrs</span></div><input type="range" id="s_yearsR" min="1" max="40" step="1" value="10" oninput="si('s_yearsR','s_years')"/></div>
            <div class="input-group stepup-field" id="stepupRow"><label>Annual Step Up</label><div class="input-row"><input type="number" id="s_stepup" value="10" oninput="ss('s_stepup','s_stepupR')"/><span class="iu">%</span></div><input type="range" id="s_stepupR" min="1" max="50" step="1" value="10" oninput="si('s_stepupR','s_stepup')"/></div>
          </div>
          <button class="calc-btn" onclick="calcSIP()">Calculate Returns</button>
        </div>
        <div class="results" id="sip-results">
          <div class="stats-row c3">
            <div class="stat-card"><div class="stat-lbl">Total Invested</div><div class="stat-val cw" id="s_invested">—</div></div>
            <div class="stat-card"><div class="stat-lbl">Est. Returns</div><div class="stat-val cg" id="s_returns">—</div></div>
            <div class="stat-card"><div class="stat-lbl">Total Value</div><div class="stat-val cb" id="s_total">—</div></div>
          </div>
          <div class="chart-card"><div class="chart-label">Growth Over Time</div><div class="chart-box"><canvas id="sipChart"></canvas></div></div>
          <div class="table-card"><div class="table-label">Year-by-Year Breakdown</div><div class="table-scroll"><table><thead><tr><th>Year</th><th>Invested</th><th>Returns</th><th>Total Value</th></tr></thead><tbody id="sipTable"></tbody></table></div></div>
          <div class="disclaimer"><p>⚠️ Estimates based on assumed return rates. Mutual fund investments are subject to market risks.</p></div>
        </div>
      </div>
      <div id="lumpsum-inputs" style="display:none;">
        <div class="form-card">
          <div class="calc-grid">
            <div class="input-group"><label>Investment Amount</label><div class="input-row"><span class="iul">₹</span><input type="number" id="l_amount" value="100000" oninput="ss('l_amount','l_amountR')"/></div><input type="range" id="l_amountR" min="1000" max="10000000" step="1000" value="100000" oninput="si('l_amountR','l_amount')"/></div>
            <div class="input-group"><label>Expected Annual Return</label><div class="input-row"><input type="number" id="l_rate" value="12" step="0.5" oninput="ss('l_rate','l_rateR')"/><span class="iu">%</span></div><input type="range" id="l_rateR" min="1" max="30" step="0.5" value="12" oninput="si('l_rateR','l_rate')"/></div>
            <div class="input-group"><label>Investment Duration</label><div class="input-row"><input type="number" id="l_years" value="10" oninput="ss('l_years','l_yearsR')"/><span class="iu">Yrs</span></div><input type="range" id="l_yearsR" min="1" max="40" step="1" value="10" oninput="si('l_yearsR','l_years')"/></div>
          </div>
          <button class="calc-btn" onclick="calcLumpsum()">Calculate Returns</button>
        </div>
        <div class="results" id="lumpsum-results">
          <div class="stats-row c3">
            <div class="stat-card"><div class="stat-lbl">Amount Invested</div><div class="stat-val cw" id="l_invested">—</div></div>
            <div class="stat-card"><div class="stat-lbl">Est. Returns</div><div class="stat-val cg" id="l_returns">—</div></div>
            <div class="stat-card"><div class="stat-lbl">Total Value</div><div class="stat-val cb" id="l_total">—</div></div>
          </div>
          <div class="chart-card"><div class="chart-label">Growth Over Time</div><div class="chart-box"><canvas id="lumpsumChart"></canvas></div></div>
          <div class="table-card"><div class="table-label">Year-by-Year Breakdown</div><div class="table-scroll"><table><thead><tr><th>Year</th><th>Value</th><th>Gain</th><th>Growth %</th></tr></thead><tbody id="lumpsumTable"></tbody></table></div></div>
          <div class="disclaimer"><p>⚠️ Estimates based on assumed return rates. Past performance is not indicative of future results.</p></div>
        </div>
      </div>
    </div>
  
    <!-- GOAL -->
    <div class="calc-panel" id="panel-goal">
      <div class="presets" id="goalPresets">
        <button class="preset-btn" onclick="setGoalPreset(50000000,25,this)">🏖️ Retirement</button>
        <button class="preset-btn" onclick="setGoalPreset(5000000,18,this)">🎓 Education</button>
        <button class="preset-btn" onclick="setGoalPreset(10000000,10,this)">🏠 Home</button>
        <button class="preset-btn" onclick="setGoalPreset(2000000,5,this)">🚗 Car</button>
        <button class="preset-btn" onclick="setGoalPreset(500000,2,this)">✈️ Travel</button>
      </div>
      <div class="form-card">
        <div class="calc-grid">
          <div class="input-group"><label>Target Amount</label><div class="input-row"><span class="iul">₹</span><input type="number" id="g_goal" value="10000000" oninput="ss('g_goal','g_goalR')"/></div><input type="range" id="g_goalR" min="100000" max="100000000" step="100000" value="10000000" oninput="si('g_goalR','g_goal')"/></div>
          <div class="input-group"><label>Time to Achieve</label><div class="input-row"><input type="number" id="g_years" value="10" oninput="ss('g_years','g_yearsR')"/><span class="iu">Yrs</span></div><input type="range" id="g_yearsR" min="1" max="40" step="1" value="10" oninput="si('g_yearsR','g_years')"/></div>
          <div class="input-group"><label>Expected Return</label><div class="input-row"><input type="number" id="g_rate" value="12" step="0.5" oninput="ss('g_rate','g_rateR')"/><span class="iu">%</span></div><input type="range" id="g_rateR" min="1" max="30" step="0.5" value="12" oninput="si('g_rateR','g_rate')"/></div>
          <div class="input-group"><label>Inflation Rate</label><div class="input-row"><input type="number" id="g_inflation" value="6" step="0.5" oninput="ss('g_inflation','g_inflationR')"/><span class="iu">%</span></div><input type="range" id="g_inflationR" min="0" max="15" step="0.5" value="6" oninput="si('g_inflationR','g_inflation')"/></div>
        </div>
        <button class="calc-btn" onclick="calcGoal()">Calculate Goal SIP</button>
      </div>
      <div class="results" id="goal-results">
        <div class="stats-row c3">
          <div class="stat-card"><div class="stat-lbl">Monthly SIP Needed</div><div class="stat-val cb" id="g_sip">—</div></div>
          <div class="stat-card"><div class="stat-lbl">Inflation Adj. Goal</div><div class="stat-val cw" id="g_inflated">—</div></div>
          <div class="stat-card"><div class="stat-lbl">Total You'll Invest</div><div class="stat-val cw" id="g_invest">—</div></div>
        </div>
        <div class="milestones" id="goalMilestones"></div>
        <div class="chart-card"><div class="chart-label">Portfolio Growth Towards Goal</div><div class="chart-box"><canvas id="goalChart"></canvas></div></div>
        <div class="disclaimer"><p>⚠️ Estimates based on assumed rates. Consult a SEBI-registered financial advisor before investing.</p></div>
      </div>
    </div>
  
    <!-- EMI -->
    <div class="calc-panel" id="panel-emi">
      <div class="presets" id="emiPresets">
        <button class="preset-btn" onclick="setEmiPreset(5000000,8.5,20,this)">🏠 Home Loan</button>
        <button class="preset-btn" onclick="setEmiPreset(800000,9,5,this)">🚗 Car Loan</button>
        <button class="preset-btn" onclick="setEmiPreset(500000,14,3,this)">💳 Personal Loan</button>
        <button class="preset-btn" onclick="setEmiPreset(1500000,10,7,this)">🎓 Education Loan</button>
      </div>
      <div class="form-card">
        <div class="calc-grid">
          <div class="input-group"><label>Loan Amount</label><div class="input-row"><span class="iul">₹</span><input type="number" id="e_amount" value="5000000" oninput="ss('e_amount','e_amountR')"/></div><input type="range" id="e_amountR" min="10000" max="50000000" step="10000" value="5000000" oninput="si('e_amountR','e_amount')"/></div>
          <div class="input-group"><label>Annual Interest Rate</label><div class="input-row"><input type="number" id="e_rate" value="8.5" step="0.1" oninput="ss('e_rate','e_rateR')"/><span class="iu">%</span></div><input type="range" id="e_rateR" min="1" max="30" step="0.1" value="8.5" oninput="si('e_rateR','e_rate')"/></div>
          <div class="input-group"><label>Loan Tenure</label><div class="input-row"><input type="number" id="e_years" value="20" oninput="ss('e_years','e_yearsR')"/><span class="iu">Yrs</span></div><input type="range" id="e_yearsR" min="1" max="30" step="1" value="20" oninput="si('e_yearsR','e_years')"/></div>
        </div>
        <button class="calc-btn" onclick="calcEMI()">Calculate EMI</button>
      </div>
      <div class="results" id="emi-results">
        <div class="emi-hero">
          <div class="emi-lbl">Your Monthly EMI</div>
          <div class="emi-val" id="e_emi">—</div>
          <div class="emi-sub">per month for <span id="e_tenure">—</span></div>
        </div>
        <div class="stats-row c2">
          <div class="stat-card"><div class="stat-lbl">Principal Amount</div><div class="stat-val cw" id="e_principal">—</div></div>
          <div class="stat-card"><div class="stat-lbl">Total Interest</div><div class="stat-val cr" id="e_interest">—</div></div>
          <div class="stat-card"><div class="stat-lbl">Total Payment</div><div class="stat-val cw" id="e_total">—</div></div>
          <div class="stat-card"><div class="stat-lbl">Interest to Principal</div><div class="stat-val cw" id="e_ratio">—</div></div>
        </div>
        <div class="chart-row">
          <div class="chart-card"><div class="chart-label">Principal vs Interest</div><div class="donut-wrap"><canvas id="emiDonut"></canvas></div></div>
          <div class="chart-card"><div class="chart-label">Balance Over Time</div><div class="chart-box-sm"><canvas id="emiBalance"></canvas></div></div>
        </div>
        <div class="table-card"><div class="table-label">Yearly Amortization</div><div class="table-scroll"><table><thead><tr><th>Year</th><th>Principal Paid</th><th>Interest Paid</th><th>Balance</th></tr></thead><tbody id="emiTable"></tbody></table></div></div>
        <div class="disclaimer"><p>⚠️ EMI calculated using reducing balance method. Verify with your bank for actual terms.</p></div>
      </div>
    </div>
  
    <!-- FREEDOM NUMBER -->
    <div class="calc-panel" id="panel-retire">
      <div class="rp-hdr">
        <div class="rp-tag">🎯 Monte Carlo · 1,000 Simulations</div>
        <h2>Know Your <em>Financial Freedom Number</em></h2>
        <p>The simulator runs 1,000 randomised market scenarios and finds exactly the corpus you need to retire safely — without running out of money.</p>
      </div>
      <div class="rp-card">
        <div class="rp-card-title">Your Details</div>
        <div class="rp-g2">
          <div class="rp-ig"><label>Annual Expenses (Today's Value)</label><div class="rp-iw"><span class="rp-pfx">₹</span><input type="number" class="rp-inp" id="rp_expenses" value="600000" oninput="rpUpdHint()"></div><div class="rp-hint" id="rp_exp_hint">₹6,00,000 / year · ₹50,000 / month</div></div>
          <div class="rp-ig"><label>Equity Allocation in Retirement</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_equityAlloc" value="50" min="0" max="100" oninput="rpUpdAlloc()"><span class="rp-sfx">%</span></div><div style="margin-top:8px;"><div class="rp-ab-wrap"><div class="rp-ab-head"><span class="rp-aeq" id="rp_eq_lbl">Equity 50%</span><span class="rp-adt" id="rp_dt_lbl">Debt 50%</span></div><div class="rp-ab"><div class="rp-ab-fill" id="rp_abar" style="width:50%"></div></div></div></div></div>
        </div>
        <div class="rp-g2">
          <div class="rp-ig"><label>Current Age</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_currentAge" value="30"><span class="rp-sfx">yrs</span></div></div>
          <div class="rp-ig"><label>Retirement Age</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_retAge" value="60"><span class="rp-sfx">yrs</span></div></div>
          <div class="rp-ig"><label>Life Expectancy</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_lifeExp" value="85"><span class="rp-sfx">yrs</span></div></div>
        </div>
        <div class="rp-ig" style="margin-bottom:4px;"><label>Target Success Probability</label>
          <div class="rp-prob-row">
            <button class="rp-pb" data-p="75" onclick="rpSetProb(this)">75%<span class="rp-pb-sub">Risky</span></button>
            <button class="rp-pb" data-p="80" onclick="rpSetProb(this)">80%<span class="rp-pb-sub">Moderate</span></button>
            <button class="rp-pb active" data-p="85" onclick="rpSetProb(this)">85%<span class="rp-pb-sub">Comfortable</span></button>
            <button class="rp-pb" data-p="90" onclick="rpSetProb(this)">90%<span class="rp-pb-sub">Conservative</span></button>
            <button class="rp-pb" data-p="95" onclick="rpSetProb(this)">95%<span class="rp-pb-sub">Very Safe</span></button>
          </div>
        </div>
        <button class="rp-adv-btn" onclick="rpTogAdv()"><span>⚙ Advanced — Equity · Debt · Inflation Parameters</span><span class="rp-arr" id="rp_arr">▼</span></button>
        <div class="rp-adv" id="rp_advPanel">
          <div class="rp-g3">
            <div class="rp-ig"><label>Equity Mean Return</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_eqMean" value="12" step="0.5"><span class="rp-sfx">%</span></div></div>
            <div class="rp-ig"><label>Equity Volatility (σ)</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_eqStd" value="18" step="0.5"><span class="rp-sfx">%</span></div></div>
            <div></div>
          </div>
          <div class="rp-g3">
            <div class="rp-ig"><label>Debt Mean Return</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_dtMean" value="7" step="0.5"><span class="rp-sfx">%</span></div></div>
            <div class="rp-ig"><label>Debt Volatility (σ)</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_dtStd" value="3" step="0.5"><span class="rp-sfx">%</span></div></div>
            <div></div>
          </div>
          <div class="rp-g3">
            <div class="rp-ig"><label>Inflation Mean</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_infMean" value="6" step="0.5"><span class="rp-sfx">%</span></div></div>
            <div class="rp-ig"><label>Inflation Volatility (σ)</label><div class="rp-iw"><input type="number" class="rp-inp rp-np" id="rp_infStd" value="2" step="0.5"><span class="rp-sfx">%</span></div></div>
            <div></div>
          </div>
          <p class="rp-adv-note">Defaults calibrated to Indian market history — Nifty 50 CAGR ~12%, India CPI ~6%. σ controls year-to-year variability.</p>
        </div>
        <button class="rp-run" id="rp_runBtn" onclick="rpGo()">▶ Calculate My Financial Freedom Number</button>
      </div>
      <div class="rp-pg" id="rp_pgWrap"><div class="rp-pg-lbl" id="rp_pgLbl">Running simulations…</div><div class="rp-pg-bar"><div class="rp-pg-fill" id="rp_pgFill"></div></div></div>
      <div id="rp-res">
        <div class="rp-div"><span>Your Financial Freedom Number</span></div>
        <div class="rp-hero">
          <div class="rp-hero-l">
            <div class="rp-hero-ey" id="rp_heroEy">Financial Freedom Number at 85% Success</div>
            <div class="rp-hero-val" id="rp_heroVal">—</div>
            <div class="rp-hero-sub" id="rp_heroSub">—</div>
            <div class="rp-hero-meta">
              <div class="rp-cm"><div class="rp-cm-val" id="rp_swr">—</div><div class="rp-cm-lbl">Withdrawal Rate</div></div>
              <div class="rp-cm"><div class="rp-cm-val" id="rp_yrs">—</div><div class="rp-cm-lbl">Retirement Period</div></div>
              <div class="rp-cm"><div class="rp-cm-val" id="rp_monthly">—</div><div class="rp-cm-lbl">Monthly Spend (Yr 1)</div></div>
              <div class="rp-cm"><div class="rp-cm-val" id="rp_sim">—</div><div class="rp-cm-lbl">Simulations Survived</div></div>
            </div>
            <div id="rp_verdict"></div>
          </div>
          <div><svg class="rp-ring" viewBox="0 0 110 110"><circle class="rp-ring-bg" cx="55" cy="55" r="43"/><circle class="rp-ring-fill" id="rp_ringFill" cx="55" cy="55" r="43" stroke-dasharray="270.18" stroke-dashoffset="270.18"/><text class="rp-ring-num" id="rp_ringNum" x="55" y="52" fill="#111827">0%</text><text class="rp-ring-lbl" x="55" y="63">Actual</text></svg></div>
        </div>
        <div class="rp-note">
          <div class="rp-note-label">What this means</div>
          <p class="rp-note-text" id="rp_noteText"></p>
          <p class="rp-note-author">Nataraj Malavade</p>
        </div>
        <div class="rp-cc"><div class="rp-cc-lbl">Corpus Projection Fan Chart</div><div class="rp-cc-sub">Shaded bands show P5–P95 range. Blue line = Median (P50). Dashed lines = P90 and P10.</div><div class="rp-ch-box"><canvas id="rp_fanC"></canvas></div></div>
        <div class="rp-bot">
          <div class="rp-cc"><div class="rp-cc-lbl">Final Corpus Distribution</div><div class="rp-cc-sub">Spread across 1,000 simulations</div><div class="rp-ch-sm"><canvas id="rp_histC"></canvas></div></div>
          <div class="rp-cc"><div class="rp-cc-lbl">Scenario Outcomes</div><div class="rp-cc-sub">Remaining corpus at end of retirement</div><table class="rp-tbl"><thead><tr><th>Scenario</th><th>What it means</th><th>Final Corpus</th></tr></thead><tbody id="rp_tBody"></tbody></table></div>
        </div>
        <div class="rp-disc">For educational purposes only. Past data ≠ future results.<br>natarajmalavade.in</div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script is:inline src="/js/calculators.js"></script>
</BaseLayout>

<style>
  .page-hero { background: var(--ink); color: #fff; padding: 48px 0 44px; position: relative; overflow: hidden; }
  .page-hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(520px 300px at 90% 0%, rgba(37,99,235,.4), transparent 70%);
    pointer-events: none;
  }
  .page-hero .container-narrow { position: relative; }
  .crumb { color: var(--ink-muted); text-decoration: none; font-size: 13px; }
  .crumb:hover { color: #fff; }
  .crumb-sep { color: #475569; margin: 0 8px; font-size: 13px; }
  .crumb-current { color: #fff; font-size: 13px; }
  .page-hero h1 { font-size: clamp(32px, 5vw, 46px); margin: 14px 0 10px; }
  .page-hero p { color: var(--ink-muted); font-size: 16.5px; margin-bottom: 22px; max-width: 560px; }
  .calc-app { padding-top: 32px; padding-bottom: 72px; }
</style>
