<script>
  // Build mailto links at runtime so the address isn't scraped from the HTML
  document.querySelectorAll<HTMLAnchorElement>('[data-email-user]').forEach((a) => {
    const user = a.dataset.emailUser;
    if (user) a.href = 'mai' + 'lto:' + user + '@' + 'natarajmalavade.in?subject=' + encodeURIComponent('Brand collaboration');
  });

  // Count-up animation for the hero stats
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix ?? '';
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / 1600, 1);
        el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + suffix;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } });
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>
