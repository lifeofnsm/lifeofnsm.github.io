---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { links } from '../data/links';

// Case-insensitive fallback for short links, e.g. /YouTube → /youtube
const map = Object.fromEntries(links.flatMap((l) => l.short.map((s) => [s, l.url])));
---
<BaseLayout title="Page not found" noindex>
  <section class="nf">
    <div class="container-narrow">
      <span class="nf__code num">404</span>
      <h1 class="display">This page doesn't exist.</h1>
      <p>The link may be old or mistyped. Everything is still reachable from the home page.</p>
      <div class="nf__ctas">
        <a href="/" class="btn btn-primary">Go to home <Icon name="arrow" /></a>
        <a href="/tools.html" class="btn btn-outline">Financial calculators</a>
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ map }}>
    var key = location.pathname.replace(/^\/+|\/+$/g, '').replace(/\.html$/, '').toLowerCase();
    if (map[key]) location.replace(map[key]);
  </script>
</BaseLayout>

<style>
  .nf { padding: 120px 0; text-align: center; }
  .nf__code { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--brand); background: var(--brand-50); padding: 6px 14px; border-radius: 999px; }
  .nf h1 { font-size: clamp(32px, 5vw, 48px); margin: 22px 0 12px; }
  .nf p { color: var(--muted); font-size: 17px; }
  .nf__ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
</style>
