---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>{site.name}</a>

    <nav class="site-nav" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <a href="/tools.html" class="btn btn-primary btn-sm site-header__cta">Free calculators</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        <span class="menu-btn__open"><Icon name="menu" size={22} /></span>
        <span class="menu-btn__close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" data-mobile-nav hidden>
    <div class="container">
      {nav.map((item) => <a href={item.href}>{item.label}<Icon name="chevron" size={18} /></a>)}
      <a href="/tools.html" class="btn btn-primary">Free calculators</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s, background .2s;
  }
  .site-header.is-scrolled { border-bottom-color: var(--border); }
  .site-header__inner { height: var(--header-h); display: flex; align-items: center; gap: 24px; }

  .brand {
    text-decoration: none; color: var(--text); flex-shrink: 0;
    font-family: var(--font-display); font-weight: 600; font-size: 21px; letter-spacing: -0.025em;
    transition: opacity .15s;
  }
  .brand:hover { opacity: .75; }
  .site-header.is-scrolled { box-shadow: 0 6px 24px -12px rgba(15,23,42,.18); }

  .site-nav { display: flex; gap: 4px; margin-left: auto; }
  .site-nav a {
    padding: 8px 12px; border-radius: 999px;
    font-size: 14px; font-weight: 500; color: var(--text-2); text-decoration: none;
    transition: background .15s, color .15s;
  }
  .site-nav a:hover { background: var(--surface-2); color: var(--text); }

  .site-header__actions { display: flex; align-items: center; gap: 8px; }

  .menu-btn {
    display: none; width: 42px; height: 42px; border-radius: 12px;
    border: 1px solid var(--border); background: #fff; color: var(--text);
    place-items: center; cursor: pointer;
  }
  .menu-btn__close { display: none; }
  .menu-btn[aria-expanded="true"] .menu-btn__open { display: none; }
  .menu-btn[aria-expanded="true"] .menu-btn__close { display: block; }

  .mobile-nav { border-top: 1px solid var(--border); background: #fff; }
  .mobile-nav .container { display: flex; flex-direction: column; padding-top: 8px; padding-bottom: 20px; }
  .mobile-nav a:not(.btn) {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 4px; border-bottom: 1px solid var(--border);
    font-weight: 600; text-decoration: none; color: var(--text);
  }
  .mobile-nav a:not(.btn) :global(svg) { color: var(--muted-light); }
  .mobile-nav .btn { margin-top: 16px; }

  @media (max-width: 860px) {
    .site-nav, .site-header__cta { display: none; }
    .site-header__actions { margin-left: auto; }
    .menu-btn { display: grid; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.hidden = !open;
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
