---
import Icon from './Icon.astro';
import { site, legalLinks } from '../data/site';
import { byGroup, byId, isExternal } from '../data/links';

const explore = [
  { label: 'Kannada channel', href: byId('yt-kannada').url },
  { label: 'Trading channel', href: byId('yt-english').url },
  { label: 'GrowGuru community', href: byId('growguru').url },
  { label: 'Trading courses', href: byId('trading').url },
  { label: 'Blog', href: byId('blog').url },
  { label: 'Financial calculators', href: '/tools.html' },
];
const socials = byGroup('community');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="f-brand">{site.name}</a>
        <p>{site.tagline}</p>
        <div class="f-social">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.title}><Icon name={s.icon} size={17} /></a>
          ))}
        </div>
      </div>

      <div class="f-col">
        <h3>Explore</h3>
        {explore.map((l) => (
          <a href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
        ))}
      </div>

      <div class="f-col">
        <h3>Company</h3>
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>

      <div class="f-col">
        <h3>Business</h3>
        <p class="f-note">Collaborations, brand deals &amp; speaking.</p>
        <a href={`https://wa.me/${site.contact.whatsappNumber}`} target="_blank" rel="noopener" class="f-wa">
          <Icon name="whatsapp" size={16} /> WhatsApp us
        </a>
      </div>
    </div>

    <p class="site-footer__disclaimer">
      Content on this website and linked channels is for educational purposes only and is not investment advice.
      Investments in securities markets are subject to market risks. Read all related documents carefully before investing.
    </p>

    <div class="site-footer__bottom">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>{site.domain}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--ink-muted); padding: 64px 0 28px; margin-top: 0; }
  .site-footer__top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 40px; border-bottom: 1px solid var(--ink-line); }
  .site-footer__brand p { font-size: 14px; margin: 14px 0 20px; max-width: 300px; line-height: 1.7; }

  .f-brand { text-decoration: none; color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: -0.025em; }

  .f-social { display: flex; gap: 8px; }
  .f-social a {
    width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center;
    color: #CBD5E1; border: 1px solid var(--ink-line); background: rgba(255,255,255,0.03);
    transition: color .15s, background .15s, border-color .15s;
  }
  .f-social a:hover { color: #fff; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); }

  .f-col { display: flex; flex-direction: column; gap: 10px; }
  .f-col h3 { color: #fff; font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 6px; }
  .f-col a { color: var(--ink-muted); text-decoration: none; font-size: 14px; transition: color .15s; width: fit-content; }
  .f-col a:hover { color: #fff; }
  .f-note { font-size: 14px; }
  .f-wa { display: inline-flex !important; align-items: center; gap: 8px; color: #4ADE80 !important; font-weight: 600; }

  .site-footer__disclaimer { font-size: 12.5px; line-height: 1.7; color: #64748B; padding: 24px 0; border-bottom: 1px solid var(--ink-line); max-width: 860px; }
  .site-footer__bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 22px; font-size: 13px; color: #64748B; }

  @media (max-width: 860px) {
    .site-footer__top { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .site-footer { padding-top: 48px; }
    .site-footer__top { grid-template-columns: 1fr 1fr; gap: 28px 16px; }
    .site-footer__top > .f-col:last-child { grid-column: 1 / -1; }
    .f-col { gap: 0; }
    .f-col h3 { margin-bottom: 4px; }
    .f-col a { padding: 9px 0; font-size: 14.5px; }   /* comfortable tap targets */
    .f-social a { width: 44px; height: 44px; }
    .site-footer__bottom { flex-direction: column; gap: 4px; }
  }
</style>
