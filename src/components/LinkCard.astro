---
import Icon from './Icon.astro';
import { isExternal, type LinkItem } from '../data/links';

interface Props { item: LinkItem; variant?: 'default' | 'feature' | 'compact' }
const { item, variant = 'default' } = Astro.props;
const ext = isExternal(item.url);
const tone =
  item.icon === 'youtube' ? 'tone-red'
  : item.icon === 'whatsapp' ? 'tone-green'
  : item.icon === 'instagram' ? 'tone-pink'
  : item.icon === 'facebook' ? 'tone-fb'
  : item.icon === 'x' ? 'tone-ink'
  : item.icon === 'pen' ? 'tone-teal'
  : 'tone-brand';
---
<a
  href={item.url}
  class:list={['card', 'link-card', `link-card--${variant}`]}
  {...(ext ? { target: '_blank', rel: 'noopener' } : {})}
  data-link-id={item.id}
>
  <div class="link-card__top">
    <span class:list={['icon-tile', tone]}><Icon name={item.icon} /></span>
    {item.lang && <span class="tag">{item.lang}</span>}
  </div>
  <h3 class="link-card__title">{item.title}</h3>
  {item.description && <p class="link-card__desc">{item.description}</p>}
  {item.tags && (
    <div class="link-card__tags">{item.tags.map((t) => <span class="tag tag-brand">{t}</span>)}</div>
  )}
  {item.cta && (
    <span class="link-card__cta">
      {item.cta}
      <Icon name={ext ? 'arrow-up-right' : 'arrow'} size={16} />
    </span>
  )}
</a>

<style>
  .link-card { display: flex !important; flex-direction: column; gap: 10px; height: 100%; }
  .link-card__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .link-card__title { font-family: var(--font-display); font-size: 18px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  .link-card__desc { color: var(--muted); font-size: 14.5px; line-height: 1.6; }
  .link-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
  .link-card__cta {
    margin-top: auto; padding-top: 10px;
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 600; color: var(--brand);
  }
  .link-card__cta :global(svg) { transition: transform .2s; }
  .link-card:hover .link-card__cta :global(svg) { transform: translate(2px, -2px); }

  .link-card--feature { padding: 28px; }
  .link-card--feature .link-card__title { font-size: 22px; }
  .link-card--compact { padding: 18px; }
  .link-card--compact .link-card__title { font-size: 16px; }

  .tone-red   { background: #FEF2F2; color: #EF4444; }
  .tone-green { background: #ECFDF5; color: #16A34A; }
  .tone-pink  { background: #FDF2F8; color: #DB2777; }
  .tone-fb    { background: #EFF6FF; color: #1877F2; }
  .tone-ink   { background: var(--surface-2); color: var(--ink); }
  .tone-teal  { background: #F0FDFA; color: #0D9488; }
  .tone-brand { background: var(--brand-50); color: var(--brand); }
</style>
